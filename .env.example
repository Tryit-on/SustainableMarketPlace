# GreenMart — environment configuration
# Copy to .env and fill in real values. Optional keys disable the feature
# they gate when left unset (per PRD: ship real or don't ship).

# --- Core (required) ---
DATABASE_URL=postgres://user:password@host:5432/greenmart
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=5000
SITE_URL=http://localhost:5000

# --- Stripe (required for checkout/subscriptions) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# --- Commission ---
PLATFORM_COMMISSION_RATE=0.1

# --- Carbon offset (optional — checkout hides the option when unset) ---
# Gold Standard offset purchase API. See server/carbonOffset.ts.
CARBON_OFFSET_API_KEY=
CARBON_OFFSET_PROVIDER=goldstandard
CARBON_OFFSET_API_URL=https://api.goldstandard.org/v1/offsets/purchase
CARBON_OFFSET_RATE_URL=https://api.goldstandard.org/v1/offsets/rate

# --- Resend (optional — email disabled when unset) ---
RESEND_API_KEY=
EMAIL_FROM=GreenMart <hello@greenmart.app>
